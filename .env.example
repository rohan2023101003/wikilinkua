# Copy this file to .env and fill in the values. .env is gitignored.
# On Toolforge there is no .env - set the same names with `toolforge envvars create`.

SECRET_KEY=change-me-to-a-long-random-string

# true  -> instant local "TestUser" login (no Wikimedia call, and no OAuth token,
#          so Commons upload stays disabled).
# false -> real Wikimedia OAuth 2.0; needs the three OAUTH_* values below.
DEV_LOGIN=true

# From your Wikimedia OAuth 2.0 consumer. Uploading pronunciations to Commons
# needs a consumer with the "upload" (and "edit") grants; an identity-only
# consumer will log users in but every upload will be refused.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:5000/oauth-callback

# Grants requested at login. Must be a subset of what your consumer was approved
# for. Leaving this empty produces a token with no API rights, and every Commons
# request fails with "You need read permission to use this module".
OAUTH_SCOPES=basic editpage uploadfile uploadeditmovefile
